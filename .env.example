# Personal Finance Tracker is fully self-contained - NO external database or JWT secret required.

# Server
PORT=5000

# No MONGODB_URI needed - data is stored in local JSON files under ./data
# No JWT_SECRET needed - a random secret is generated at startup
#   (without JWT_SECRET, login tokens reset whenever the server restarts)

# Admin account defaults (optional overrides - the values below are the built-in defaults)
ADMIN_NAME=Admin
ADMIN_EMAIL=ratnasampath.5680@gmail.com
ADMIN_PASSWORD=Sampath@333

# Optional: point data storage elsewhere, e.g. a persistent disk mounted on the host
# DATA_DIR=/var/data
